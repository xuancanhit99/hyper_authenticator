{
  "manifest_version": 3,
  "name": "Hyper Authenticator",
  "description": "Tạo mã TOTP local-first và đồng bộ tùy chọn với tài khoản HyperZ.",
  "version": "1.1.3",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Mở Hyper Authenticator",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://supabase-api.vnpay.dev/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://supabase-api.vnpay.dev wss://supabase-api.vnpay.dev"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
